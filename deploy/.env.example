# ========================
# Happy Server 鐜鍙橀噺閰嶇疆
# ========================

NODE_ENV=production
APP_PORT=3000
METRICS_ENABLED=true
METRICS_PORT=9090
HANDY_MASTER_SECRET=your-secure-random-secret-here

# PostgreSQL
POSTGRES_USER=happy
POSTGRES_PASSWORD=secure-password-change-me
POSTGRES_DB=happy_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=secure-password-change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 Configuration
S3_BUCKET=happy
S3_USE_SSL=false

# Optional
LOG_LEVEL=info
CORS_ENABLED=true
CORS_ORIGIN=*
TEST_MODE=false
